# Photo scan (/build) needs an Anthropic API key on the server. Without it the
# scan button reports "not set up" and students pick parts by hand.
ANTHROPIC_API_KEY=

# Optional
# JUMPER_VISION_MODEL=claude-opus-5-5   # default; claude-sonnet-5-5 is cheaper
# SCAN_PER_HOUR=5                       # scans per visitor per hour
# SCAN_DAILY_LIMIT=200                  # scans per server per day
